# Minds by Animoca Brands — Builder API credentials
# Get these from https://build.hellominds.ai/en/docs/get-started/account-setup
MINDS_BUILDER_API_KEY=your-builder-api-key-here
MINDS_MIND_ID=your-mind-id-here

# Vercel Cron secret for the monitoring loop
# Generate with: openssl rand -hex 32
# Set in Vercel env vars and in the cron config
CRON_SECRET=your-cron-secret-here
